# Seedling Desktop API server — environment variables
# Copy this file to `.env` and fill in the secrets, OR set these in your
# process environment (preferred for prod).

# ── SQL Server connection ──────────────────────────────────────────────
SQL_SERVER=WVIDEVGBR-DB01,1433          # host[,port]  (tcp: prefix optional)
SQL_DATABASE=GHSeed
SQL_USER=WebAppUser                     # empty = Windows Auth (needs msnodesqlv8 — see lib/db/src/index.ts)
SQL_PASSWORD=                           # *** SECRET — fill in or set in env, do not commit ***
SQL_ENCRYPT=false                       # set "true" in prod if cert is trusted
SQL_TRUST_CERT=true                     # accept self-signed certs (dev)

# ── HTTP server ────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Auth secrets ───────────────────────────────────────────────────────
TOKEN_SECRET=                           # *** SECRET — 32+ random bytes; required in production. ***
                                        # Generate fresh per environment.
UPLOAD_JWT_SECRET=                      # *** SECRET — only required if the Flask Upload App is wired up ***
                                        # Must match the Flask app's JWT_SECRET.

# ── Upload app (optional) ──────────────────────────────────────────────
UPLOAD_APP_URL=http://localhost:5000

# ── Background jobs ────────────────────────────────────────────────────
ENABLE_NOTIFIERS=false                  # set "true" to start daily cron jobs (acid-treat, transplant, sow-start)
